# Musterlösung Abschlussprojekt (Linux-nftables als Stand-in für die OPNsense-Regeln)
# Zonen: v-lan (LAN), v-dmz (DMZ, Server 10.8.2.2), v-wan („Internet“)
flush ruleset
table inet fw {
  set alias_web_ports { type inet_service; elements = { 80, 8080 } }
  set alias_dmz_server { type ipv4_addr; elements = { 10.8.2.2 } }

  chain input {                       # Verkehr an die Firewall selbst
    type filter hook input priority 0; policy drop;
    iifname "lo" accept
    ct state established,related accept
    iifname "v-lan" icmp type echo-request accept comment "LAN darf die Firewall anpingen"
    counter comment "ENDE input"
  }
  chain forward {                     # Verkehr durch die Firewall
    type filter hook forward priority 0; policy drop;
    ct state established,related accept
    iifname "v-lan" oifname "v-dmz" tcp dport 22 log group 6 prefix "SSH-GESPERRT " counter drop
    iifname "v-lan" oifname "v-dmz" ip daddr @alias_dmz_server tcp dport @alias_web_ports accept comment "LAN -> DMZ Web"
    iifname "v-lan" oifname "v-wan" tcp dport { 80, 443 } accept comment "LAN -> Internet Web"
    iifname "v-wan" oifname "v-dmz" ct status dnat ip daddr 10.8.2.2 tcp dport 80 accept comment "Portweiterleitung"
    counter comment "ENDE forward"
  }
}
table ip nat {
  chain pre {
    type nat hook prerouting priority -100;
    iifname "v-wan" tcp dport 8080 dnat to 10.8.2.2:80
  }
  chain post {
    type nat hook postrouting priority 100;
    oifname "v-wan" masquerade
  }
}
